{
  "name": "@eflink-tech/excel",
  "description": "开箱即用的在线表格编辑器 React 组件（基于 Univer），可独立运行，也可作为组件嵌入任意 React 应用",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "scripts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.lib.json && vite build --watch",
    "build": "vite build --emptyOutDir && tsc -p tsconfig.lib.json",
    "lint": "oxlint src",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/patch-univer.js"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@univerjs/core": "^0.25.1",
    "@univerjs/preset-sheets-core": "^0.25.1",
    "@univerjs/preset-sheets-drawing": "^0.25.1",
    "@univerjs/preset-sheets-filter": "^0.25.1",
    "@univerjs/preset-sheets-find-replace": "^0.25.1",
    "@univerjs/preset-sheets-hyper-link": "^0.25.1",
    "@univerjs/preset-sheets-sort": "^0.25.1",
    "@univerjs/preset-sheets-thread-comment": "^0.25.1",
    "@univerjs/presets": "^0.25.1",
    "dexie": "^4.4.5",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.37.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eflink-tech/eflink-excel.git",
    "directory": "packages/excel"
  },
  "bugs": {
    "url": "https://github.com/eflink-tech/eflink-excel/issues"
  },
  "homepage": "https://github.com/eflink-tech/eflink-excel#readme",
  "keywords": [
    "spreadsheet",
    "excel",
    "univer",
    "react-component",
    "xlsx",
    "editor",
    "sheets"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
